{
  "name": "signal-lost",
  "version": "1.0.0-rc1",
  "private": true,
  "type": "module",
  "description": "A cooperative, asymmetric space-station puzzle game for 2-4 players.",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
