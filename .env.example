PORT=3000
HOST=0.0.0.0
# Set to the exact HTTPS origin when deploying (no trailing slash).
# PUBLIC_ORIGIN=https://your-game.example.com

# Optional. Gameplay does not need an API key. Keys stay on the server.
ENABLE_AI_BRIEFINGS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MAX_CALLS_PER_HOUR=10
# Also set a project budget in your OpenAI account. The cap below is per process.
MAX_ROOMS=100
